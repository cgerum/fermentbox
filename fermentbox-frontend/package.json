{
  "name": "fermentbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "lint": "vue-cli-service lint",
    "api:validate": "swagger-cli validate ../api/fermentbox.openapi.yaml",
    "api:generate:types": "openapi-typescript ../api/fermentbox.openapi.yaml --output src/services/api-contract.d.ts",
    "api:generate:runtime": "node scripts/generate-api-client.js",
    "api:generate": "yarn api:generate:types && yarn api:generate:runtime",
    "api:check": "yarn api:validate && yarn api:generate",
    "api:verify-fresh": "git diff --exit-code src/services/api-contract.d.ts src/services/api-generated.js",
    "test": "NODE_OPTIONS=--openssl-legacy-provider jest",
    "test:watch": "NODE_OPTIONS=--openssl-legacy-provider jest --watch",
    "test:coverage": "NODE_OPTIONS=--openssl-legacy-provider jest --coverage"
  },
  "dependencies": {
    "core-js": "3.49.0",
    "vue": "2.7.16",
    "vuedraggable": "2.24.3",
    "vuetify": "2.7.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@vue/cli-plugin-babel": "4.5.19",
    "@vue/cli-plugin-eslint": "4.5.19",
    "@vue/cli-service": "4.5.19",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^27.0.0-alpha.4",
    "ajv": "^8.17.1",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.5.1",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "openapi-typescript": "^7.10.1",
    "sass": "^1.19.0",
    "sass-loader": "^8.0.0",
    "typescript": "5.6.3",
    "vue-cli-plugin-vuetify": "2.5.8",
    "vue-template-compiler": "2.7.16",
    "vuetify-loader": "1.9.2",
    "yaml": "^2.8.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "tests/unit/**/*.js"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
